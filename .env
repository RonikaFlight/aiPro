# ============================================================
# ProofPilot — Environment Variables
# ============================================================
# Copy to `.env` and adjust. Production must set every variable marked
# [REQUIRED-PROD]. The app refuses to start in production with unsafe
# defaults (see src/lib/env.ts).
# ============================================================

# ---------- Application ----------
NODE_ENV=development                       # development|staging|production
APP_ENV=development                        # mirror of NODE_ENV used by app code
APP_NAME=ProofPilot
APP_URL=http://localhost:3000              # public base URL; HTTPS required in prod
APP_PORT=3000

# ---------- Database ----------
# Sandbox uses SQLite. Production should switch to PostgreSQL.
DATABASE_PROVIDER=sqlite                   # sqlite|postgresql
# SQLite path (relative to project root)
DATABASE_URL=file:./db/custom.db?connection_limit=1
# PostgreSQL example (production):
# DATABASE_URL=postgresql://proofpilot:strong-password@localhost:5432/proofpilot

# ---------- Redis (optional) ----------
# Not used in sandbox. Production uses Redis for BullMQ + rate limiting + pub/sub.
# REDIS_URL=redis://localhost:6379

# ---------- Session & CSRF ----------
SESSION_COOKIE_NAME=proofpilot_session
# In dev over HTTP, __Host- prefix won't work (requires Secure). Use a plain name.
# SESSION_COOKIE_NAME=__Host-proofpilot_session
SESSION_ABSOLUTE_TTL_SECONDS=432000         # 5 days absolute cap
SESSION_IDLE_TTL_SECONDS=86400              # 1 day idle
# [REQUIRED-PROD] Strong random ≥ 32 bytes. Used for HMAC of session token hashes.
SESSION_SECRET=dev-only-do-not-use-in-prod-please-replace-with-32+random-bytes
CSRF_SECRET=dev-only-csrf-secret-replace-in-prod-32+random-bytes

# ---------- Crypto (Secret Vault) ----------
# 32-byte base64 master key for AES-256-GCM envelope encryption.
# Generate with: openssl rand -base64 32
# [REQUIRED-PROD]
PROOFPILOT_ENCRYPTION_KEY=AAEC+vgBm0YxmK8Zp0y6nQx6m0YxmK8Zp0y6nQx6m0Y=
MASTER_KEY_VERSION=1

# ---------- Object Storage (S3 / MinIO) ----------
# In sandbox, artifacts are stored on local filesystem under ./storage/artifacts.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=proofpilot-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# ---------- Email ----------
# In sandbox, email is logged to console (and Mailpit if configured).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@proofpilot.local
SMTP_FROM_NAME=ProofPilot
MAILPIT_URL=http://localhost:8025

# ---------- OAuth ----------
# Optional. When client ID is empty, OAuth buttons are hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# ---------- Stripe ----------
# When STRIPE_SECRET_KEY is empty, billing runs in DEV MODE (synthetic responses).
# [REQUIRED-PROD if billing is live]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
STRIPE_DEV_MODE=true                      # set false in prod when STRIPE_SECRET_KEY is set

# ---------- AI ----------
# Provider: glm (default; uses z-ai-web-dev-sdk) | openai-compatible | mock
AI_PROVIDER=glm
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=glm-4.6
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS_PER_RUN=20000
AI_DAILY_WORKSPACE_BUDGET_TOKENS=100000

# ---------- Worker Mini-Service ----------
WORKER_PORT=3003
WORKER_CONCURRENCY=2
WORKER_BROWSER_TIMEOUT_MS=60000
WORKER_MAX_PAGES_PER_RUN=50
WORKER_MAX_RESPONSE_SIZE_BYTES=5242880     # 5 MiB
PLAYWRIGHT_BROWSERS_PATH=

# ---------- Scanner ----------
SCAN_ALLOW_HTTP_LOCAL=false                # allow http:// targets in local dev only
# [REQUIRED-PROD=false] Must be false in production. Refuses to start if true in prod.
SCAN_PRIVATE_NETWORK_OVERRIDE=false
SCAN_DEFAULT_VIEWPORTS=mobile:390x844,tablet:768x1024,laptop:1366x768,desktop:1920x1080
SCAN_DEFAULT_MAX_PAGES=20
SCAN_DEFAULT_MAX_DEPTH=3
SCAN_DEFAULT_TIMEOUT_MS=60000

# ---------- Logging ----------
LOG_LEVEL=info                             # trace|debug|info|warn|error|fatal
LOG_FORMAT=pretty                          # json|pretty (use json in prod)
LOG_SERVICE_NAME=proofpilot-api

# ---------- OpenTelemetry (optional) ----------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=proofpilot
OTEL_TRACES_ENABLED=false

# ---------- Feature Flags ----------
FEATURE_AI_ENRICHMENT=true
FEATURE_PUBLIC_SCANS=true
FEATURE_FIREFOX_SCANNING=false
FEATURE_WEBKIT_SCANNING=false
FEATURE_VISUAL_REGRESSION=true
FEATURE_AGENCY_BRANDING=true
FEATURE_EXPERIMENTAL_INTEGRATIONS=false
FEATURE_PUBLIC_API_DOCS=false              # expose /docs/api in non-prod

# ---------- Retention ----------
RETENTION_ARTIFACT_DAYS=30
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_SESSION_IDLE_DAYS=1

# ---------- CAPTCHA (public scans) ----------
CAPTCHA_PROVIDER=                          # empty = disabled (dev only)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# ---------- Rate Limits ----------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=300
RATE_LIMIT_PUBLIC_SCAN_MAX=3
RATE_LIMIT_PUBLIC_SCAN_WINDOW_SECONDS=3600
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60

# ---------- Local Dev Overrides ----------
DEV_DEMO_TARGET_URL=http://localhost:3000/demo-target
DEV_ALLOW_LOCALHOST_TARGETS=true          # only honored when APP_ENV=development
