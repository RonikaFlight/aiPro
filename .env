DATABASE_URL=file:/home/z/my-project/db/custom.db
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000
SESSION_COOKIE_NAME=proofpilot_session
SESSION_ABSOLUTE_TTL_SECONDS=432000
SESSION_IDLE_TTL_SECONDS=86400
SESSION_SECRET=dev-session-secret-do-not-use-in-production-32chars
CSRF_SECRET=dev-csrf-secret-do-not-use-in-production-32chars
PROOFPILOT_ENCRYPTION_KEY=dev-master-key-base64-32bytes!
MASTER_KEY_VERSION=1
STRIPE_DEV_MODE=true
AI_PROVIDER=mock
WORKER_PORT=3003
WORKER_CONCURRENCY=2
WORKER_BROWSER_TIMEOUT_MS=60000
WORKER_MAX_PAGES_PER_RUN=50
WORKER_MAX_RESPONSE_SIZE_BYTES=5242880
SCAN_ALLOW_HTTP_LOCAL=true
SCAN_PRIVATE_NETWORK_OVERRIDE=false
SCAN_DEFAULT_VIEWPORTS=mobile:390x844,tablet:768x1024,laptop:1366x768,desktop:1920x1080
SCAN_DEFAULT_MAX_PAGES=20
SCAN_DEFAULT_MAX_DEPTH=3
SCAN_DEFAULT_TIMEOUT_MS=60000
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_SERVICE_NAME=proofpilot-api
FEATURE_AI_ENRICHMENT=true
FEATURE_PUBLIC_SCANS=true
FEATURE_FIREFOX_SCANNING=false
FEATURE_WEBKIT_SCANNING=false
FEATURE_VISUAL_REGRESSION=true
FEATURE_AGENCY_BRANDING=true
FEATURE_EXPERIMENTAL_INTEGRATIONS=false
FEATURE_PUBLIC_API_DOCS=false
RETENTION_ARTIFACT_DAYS=30
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_SESSION_IDLE_DAYS=1
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=300
RATE_LIMIT_PUBLIC_SCAN_MAX=3
RATE_LIMIT_PUBLIC_SCAN_WINDOW_SECONDS=3600
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
DEV_DEMO_TARGET_URL=http://localhost:3000/demo-target
DEV_ALLOW_LOCALHOST_TARGETS=true

# OAuth providers (leave empty to disable; configure to enable "Continue with X" buttons).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/github/callback
